#!/usr/bin/env bash
# shrink: makes a Shrunk copy of each file it's given, next to the original,
# which stays untouched. install.sh links it to ~/.local/bin/shrink. Runs on
# stock macOS bash 3.2. test/shrink.sh tests it against fakes of the tools it
# runs.
set -uo pipefail

# Settings. A SHRINK_* variable overrides each default, and a flag overrides
# that.
DEFAULT_CRF=23
DEFAULT_MAX_RES=1080
DEFAULT_FPS=30
DEFAULT_AUDIO_BITRATE=128k
DEFAULT_MAX_EDGE=2560
DEFAULT_QUALITY=80
VIDEO_EXTS="mov mp4 m4v mkv avi webm"
IMAGE_EXTS="jpg jpeg png heic heif webp tif tiff"
TYPES="video image"

usage() {
  cat <<EOF
usage: shrink [options] FILE...
Makes a smaller copy of each file next to it: a.mov -> a.shrunk.mp4.

  -o PATH       write into folder PATH, or, for one file, to file PATH
  -f            replace existing outputs; also shrink *.shrunk.* files
  -n            print the commands instead of running them
  --crf N       video quality, 0-51, lower is better (\$SHRINK_CRF, default $DEFAULT_CRF)
  -h            this help
  --help [TYPE] every setting for TYPE ($TYPES), or for every type
EOF
}

help_video() {
  cat <<EOF
video: ${VIDEO_EXTS// /, } -> .mp4 (H.264 and AAC)
  --crf N             quality, 0-51, lower is better and bigger  \$SHRINK_CRF            default $DEFAULT_CRF
  --max-res N         caps the short side (an even number)       \$SHRINK_MAX_RES        default $DEFAULT_MAX_RES
  --fps N             caps the frame rate, never raises it       \$SHRINK_FPS            default $DEFAULT_FPS
  --audio-bitrate R   AAC stereo bitrate, such as 96k            \$SHRINK_AUDIO_BITRATE  default $DEFAULT_AUDIO_BITRATE
  fixed:      never enlarged; 8-bit 4:2:0 color; metadata kept; +faststart
  HDR:        an HDR input (PQ or HLG, as iPhones record) is warned about and still
              shrunk: the copy is standard range and looks washed out
  progress:   ffmpeg's progress line, when stderr is a terminal
  runs:       ffprobe (size, frame rate and transfer function), then
              ffmpeg -i IN -map_metadata 0 -c:v libx264 -crf N -pix_fmt yuv420p [-vf caps]
                -c:a aac -b:a R -ac 2 -movflags +faststart+use_metadata_tags OUT
EOF
}

help_image() {
  cat <<EOF
image: ${IMAGE_EXTS// /, } -> the same format, except HEIC, HEIF and TIFF -> .jpg
  --max-edge N        caps the long edge, never enlarges         \$SHRINK_MAX_EDGE       default $DEFAULT_MAX_EDGE
  --quality N         1-100: JPEG and WebP quality, PNG's top    \$SHRINK_QUALITY        default $DEFAULT_QUALITY
                      quality for pngquant
  fixed:      metadata kept, the EXIF orientation tag included, and pixels not
              rotated; except a HEIC comes out upright with orientation 1, and a
              TIFF is turned upright and loses its EXIF (a JPEG can't carry its tags)
  runs:       JPEG, WebP, HEIC, TIFF: magick IN -resize NxN\> -quality Q OUT
              PNG: magick IN -resize NxN\> TMP.png, then
                pngquant --quality=0-Q --output OUT TMP.png, then copies TMP's
                EXIF chunk, which pngquant drops, into OUT
EOF
}

help_type() {
  case "$1" in
    video) help_video ;;
    image) help_image ;;
  esac
}

die_usage() {
  echo "shrink: $1" >&2
  echo "run shrink -h for usage" >&2
  exit 2
}

# from <variable>: names where a setting came from, for error messages.
from() { if [[ -n "${!1:-}" ]]; then echo "$1"; else echo default; fi; }
crf="${SHRINK_CRF:-$DEFAULT_CRF}" crf_from="$(from SHRINK_CRF)"
max_res="${SHRINK_MAX_RES:-$DEFAULT_MAX_RES}" max_res_from="$(from SHRINK_MAX_RES)"
fps="${SHRINK_FPS:-$DEFAULT_FPS}" fps_from="$(from SHRINK_FPS)"
audio_bitrate="${SHRINK_AUDIO_BITRATE:-$DEFAULT_AUDIO_BITRATE}" audio_bitrate_from="$(from SHRINK_AUDIO_BITRATE)"
max_edge="${SHRINK_MAX_EDGE:-$DEFAULT_MAX_EDGE}" max_edge_from="$(from SHRINK_MAX_EDGE)"
quality="${SHRINK_QUALITY:-$DEFAULT_QUALITY}" quality_from="$(from SHRINK_QUALITY)"
output="" force=false dry=false
files=()
while (($#)); do
  case "$1" in
    -h) usage; exit 0 ;;
    --help)
      if [[ $# -gt 1 && "$2" != -* ]]; then
        case " $TYPES " in
          *" $2 "*) help_type "$2"; exit 0 ;;
          *) die_usage "no type $2; types: $TYPES" ;;
        esac
      fi
      for t in $TYPES; do help_type "$t"; done
      exit 0 ;;
    -o) (($# > 1)) || die_usage "-o needs a path"; output="$2"; shift ;;
    -f) force=true ;;
    -n) dry=true ;;
    --crf=* | --max-res=* | --fps=* | --audio-bitrate=* | --max-edge=* | --quality=*)
      set -- "${1%%=*}" "${1#*=}" "${@:2}"; continue ;;
    --crf | --max-res | --fps | --audio-bitrate | --max-edge | --quality)
      (($# > 1)) || die_usage "$1 needs a value"
      case "$1" in
        --crf) crf="$2" crf_from="--crf" ;;
        --max-res) max_res="$2" max_res_from="--max-res" ;;
        --fps) fps="$2" fps_from="--fps" ;;
        --audio-bitrate) audio_bitrate="$2" audio_bitrate_from="--audio-bitrate" ;;
        --max-edge) max_edge="$2" max_edge_from="--max-edge" ;;
        --quality) quality="$2" quality_from="--quality" ;;
      esac
      shift ;;
    --) shift; files+=("$@"); break ;;
    -?*) die_usage "unknown option $1" ;;
    *) files+=("$1") ;;
  esac
  shift
done
((${#files[@]})) || die_usage "no files given"
if ! [[ "$crf" =~ ^[0-9]+$ ]] || ((10#$crf > 51)); then
  die_usage "$crf_from must be a whole number from 0 to 51, not '$crf'"
fi
# yuv420p needs even sizes, so the short side's cap is even too.
if ! [[ "$max_res" =~ ^[0-9]+$ ]] || ((10#$max_res == 0 || 10#$max_res % 2)); then
  die_usage "$max_res_from must be an even number above 0, not '$max_res'"
fi
if ! [[ "$fps" =~ ^[0-9]+$ ]] || ((10#$fps == 0)); then
  die_usage "$fps_from must be a whole number above 0, not '$fps'"
fi
[[ "$audio_bitrate" =~ ^[1-9][0-9]*k$ ]] ||
  die_usage "$audio_bitrate_from must be a rate in kbit/s such as 96k, not '$audio_bitrate'"
if ! [[ "$max_edge" =~ ^[0-9]+$ ]] || ((10#$max_edge == 0)); then
  die_usage "$max_edge_from must be a whole number above 0, not '$max_edge'"
fi
if ! [[ "$quality" =~ ^[0-9]+$ ]] || ((10#$quality == 0 || 10#$quality > 100)); then
  die_usage "$quality_from must be a whole number from 1 to 100, not '$quality'"
fi
crf=$((10#$crf)) max_res=$((10#$max_res)) fps=$((10#$fps)) max_edge=$((10#$max_edge)) quality=$((10#$quality))
out_dir=""
if [[ -n "$output" ]]; then
  if [[ -d "$output" ]]; then
    out_dir="${output%/}"
  elif [[ "$output" == */ ]]; then
    die_usage "-o $output: no such folder"
  elif ((${#files[@]} > 1)); then
    die_usage "-o $output isn't a folder; a file name works for one input only"
  fi
fi

# human <bytes>: 1.0 MB, 100 kB, 512 B (powers of 1000, as Finder shows them).
human() {
  awk -v b="$1" 'BEGIN {
    if (b >= 1e9) printf "%.1f GB", b / 1e9
    else if (b >= 1e6) printf "%.1f MB", b / 1e6
    else if (b >= 1e3) printf "%d kB", b / 1e3
    else printf "%d B", b
  }'
}

lower() { tr '[:upper:]' '[:lower:]' <<<"$1"; }

# A path as ffmpeg should get it: it would read a leading - as an option and
# anything before a : as a protocol.
ff_path() {
  case "$1" in
    *:*) printf 'file:%s' "$1" ;;
    -*) printf './%s' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# A path as magick, pngquant or touch should get it: they read a leading - as
# an option. magick reads an existing file's name as is, even with a : or [.
dash_path() {
  case "$1" in
    -*) printf './%s' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# run <command...>: runs it, or with -n prints it, quoted for a shell.
run() {
  if $dry; then
    local a line=""
    for a in "$@"; do line+="${line:+ }$(printf '%q' "$a")"; done
    echo "$line"
  else
    "$@"
  fi
}

# needs <input> <tool>: fails, naming the tool, if it isn't on PATH.
needs() {
  command -v "$2" >/dev/null && return 0
  echo "shrink: $1: needs $2, which isn't installed; run install.sh from the dotfiles repo" >&2
  return 1
}

# probe_video <input>: warns on stderr when the video is HDR, and prints the
# -vf value capping the short side and frame rate, empty when neither cap
# applies. ffprobe prints fields in its own order, whatever order they're
# asked for, so they're read by name. ffmpeg rotates phone video upright
# before the filters, so the scale expression picks the short side after
# rotation. yuv420p needs even sizes: the cap's -2 keeps them even, and an odd
# size below the cap loses a pixel.
probe_video() {
  local probe key value width="" height="" rate="" transfer="" filters=()
  probe="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=width,height,avg_frame_rate,color_transfer -of default=nw=1 "$(ff_path "$1")")" || return 1
  while IFS='=' read -r key value; do
    case "$key" in
      width) width="$value" ;;
      height) height="$value" ;;
      avg_frame_rate) rate="$value" ;;
      color_transfer) transfer="$value" ;;
    esac
  done <<<"$probe"
  [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || { echo "shrink: $1: no video stream found" >&2; return 1; }
  case "$transfer" in
    smpte2084) transfer=PQ ;;
    arib-std-b67) transfer=HLG ;;
    *) transfer="" ;;
  esac
  [[ -z "$transfer" ]] ||
    echo "shrink: $1 is HDR ($transfer); the shrunk copy is standard range and will look washed out" >&2
  if (((width < height ? width : height) > max_res)); then
    filters+=("scale='if(gt(iw,ih),-2,$max_res)':'if(gt(iw,ih),$max_res,-2)'")
  elif ((width % 2 || height % 2)); then
    filters+=("scale='trunc(iw/2)*2':'trunc(ih/2)*2'")
  fi
  if awk -v r="$rate" -v max="$fps" 'BEGIN { split(r, p, "/"); exit !(p[2] > 0 && p[1] / p[2] > max + 0.01) }'; then
    filters+=("fps=$fps")
  fi
  local IFS=,
  echo "${filters[*]-}"
}

# shrink_video <input> <part file>. use_metadata_tags keeps tags such as
# Apple's location, which a plain -map_metadata 0 drops. yuv420p turns 10-bit
# and 4:4:4 input into the 8-bit 4:2:0 H.264 that Apple's players open. At
# -loglevel error, ffmpeg prints its progress line only when given -stats.
shrink_video() {
  local filters vf=() stats=-nostats
  needs "$1" ffmpeg && needs "$1" ffprobe || return 1
  filters="$(probe_video "$1")" || return 1
  [[ -z "$filters" ]] || vf=(-vf "$filters")
  [[ ! -t 2 ]] || stats=-stats
  run ffmpeg -nostdin -hide_banner -loglevel error "$stats" -y -i "$(ff_path "$1")" -map_metadata 0 \
    -c:v libx264 -crf "$crf" -pix_fmt yuv420p ${vf[@]+"${vf[@]}"} -c:a aac -b:a "$audio_bitrate" -ac 2 \
    -movflags +faststart+use_metadata_tags -f mp4 "$(ff_path "$2")"
}

# exif_chunk <png>: prints the offset and data length of its eXIf chunk (its
# EXIF, with the orientation tag), or nothing. Chunks are walked up to the
# image data, which the EXIF has to come before.
# shellcheck disable=SC2329  # called from copy_exif
exif_chunk() {
  local at=8 size len type
  size="$(stat -f %z "$1")" || return 1
  while ((at + 8 <= size)); do
    read -r len type < <(od -An -tu1 -j "$at" -N8 "$1" |
      awk '{ printf "%d %c%c%c%c\n", (($1 * 256 + $2) * 256 + $3) * 256 + $4, $5, $6, $7, $8 }')
    case "$type" in
      eXIf) echo "$at $len"; return ;;
      IDAT | IEND) return 0 ;;
    esac
    at=$((at + len + 12))
  done
}

# copy_exif <from.png> <to.png>: copies from's eXIf chunk into to, after IHDR,
# since pngquant drops it on a Mac; a to that kept its own is left alone. The
# chunk goes over as is, CRC and all.
# shellcheck disable=SC2329  # called through run
copy_exif() {
  local chunk at len
  chunk="$(exif_chunk "$1")" && [[ -n "$chunk" ]] || return 0
  [[ -z "$(exif_chunk "$2")" ]] || return 0
  read -r at len <<<"$chunk"
  # 33 bytes: the signature and IHDR, always first. dd, since a head closing a
  # pipe early fails it under pipefail.
  { head -c 33 "$2" && dd if="$1" bs=1 skip="$at" count=$((len + 12)) 2>/dev/null && tail -c +34 "$2"; } >"$2.exif" &&
    mv -f "$2.exif" "$2"
}

# shrink_image <input> <part file> <output format: jpg, png or webp>. magick
# keeps metadata and doesn't rotate pixels unless asked to, with two
# exceptions: a HEIC's own rotation is applied as it's read, and the EXIF
# orientation becomes 1 to match; a TIFF's orientation is a tag a JPEG can't
# carry, so it's turned upright here, and its EXIF is lost.
shrink_image() {
  local resize=(-resize "${max_edge}x${max_edge}>") orient=()
  needs "$1" magick || return 1
  if [[ "$3" == png ]]; then
    needs "$1" pngquant || return 1
    run magick "$(dash_path "$1")" "${resize[@]}" "png:$2.png" &&
      run pngquant "--quality=0-$quality" --force --output "$(dash_path "$2")" "$(dash_path "$2.png")" &&
      run copy_exif "$2.png" "$2" &&
      run rm -f "$2.png"
    return
  fi
  case "$(lower "${1##*.}")" in
    tif | tiff) orient=(-auto-orient) ;;
  esac
  run magick "$(dash_path "$1")" ${orient[@]+"${orient[@]}"} "${resize[@]}" -quality "$quality" "$3:$2"
}

# type_of <name>: video, image, or nothing for an unsupported type.
type_of() {
  local ext
  [[ "$1" == *.* ]] || return 0
  ext="$(lower "${1##*.}")"
  if [[ " $VIDEO_EXTS " == *" $ext "* ]]; then
    echo video
  elif [[ " $IMAGE_EXTS " == *" $ext "* ]]; then
    echo image
  fi
}

# ext_format <name>: the format its extension names, when shrink writes that
# format: jpg, png, webp or mp4.
ext_format() {
  case "$(lower "${1##*.}")" in
    jpg | jpeg) echo jpg ;;
    png | webp | mp4) lower "${1##*.}" ;;
  esac
}

# format_of <type> <name>: the format its Shrunk copy comes out in. An image
# keeps its format if shrink writes it, and becomes a JPEG otherwise (HEIC,
# HEIF, TIFF).
format_of() {
  local format
  case "$1" in
    video) echo mp4 ;;
    image) format="$(ext_format "$2")"; echo "${format:-jpg}" ;;
  esac
}

# shrink_type <type> <input> <part file> <format>
shrink_type() {
  case "$1" in
    video) shrink_video "$2" "$3" ;;
    image) shrink_image "$2" "$3" "$4" ;;
  esac
}

# The output being written, removed if shrink is interrupted or the file
# fails, so no half-written output is left.
part=""
drop_part() {
  [[ -z "$part" ]] || rm -f "$part" "$part.png" "$part.exif"
  part=""
}
trap 'drop_part; exit 129' HUP
trap 'drop_part; exit 130' INT
trap 'drop_part; exit 143' TERM

# Outputs written in this run, one per line: -f replaces an older copy, not
# one another input made a moment ago.
written=""

# shrink_file <input>: makes its Shrunk copy and prints one summary line.
shrink_file() {
  local in="$1" name type format out_ext out before after
  name="$(basename "$in")"
  type="$(type_of "$name")"
  if [[ -z "$type" ]]; then
    echo "shrink: $in: unsupported type" >&2
    return 1
  fi
  [[ -f "$in" ]] || { echo "shrink: $in: no such file" >&2; return 1; }
  if [[ "$name" == *.shrunk.* ]] && ! $force; then
    echo "$in: skipped, already a Shrunk copy (-f to shrink it again)"
    return 0
  fi

  format="$(format_of "$type" "$name")"
  # A copy in the input's own format keeps its extension as written: a.JPEG
  # becomes a.shrunk.JPEG.
  out_ext="$format"
  [[ "$type" != image || "$(ext_format "$name")" != "$format" ]] || out_ext="${name##*.}"
  if [[ -n "$output" && -z "$out_dir" ]]; then
    out="$output"
    [[ "$(ext_format "$out")" == "$format" ]] ||
      { echo "shrink: $in: -o $output must end in .$format, the format $name comes out in" >&2; return 1; }
  else
    out="${out_dir:-$(dirname "$in")}/${name%.*}.shrunk.$out_ext"
    [[ -n "$out_dir" || "$in" == */* ]] || out="${out#./}"
  fi
  if [[ "$out" -ef "$in" ]]; then
    echo "shrink: $in: the output would replace the original" >&2
    return 1
  fi
  if grep -qxF -- "$out" <<<"$written"; then
    echo "shrink: $in: $out was just made from another file" >&2
    return 1
  fi
  if [[ -e "$out" ]] && ! $force; then
    echo "shrink: $in: $out already exists (-f to replace it)" >&2
    return 1
  fi

  part="$(dirname "$out")/.$(basename "$out").part"
  if ! shrink_type "$type" "$in" "$part" "$format"; then
    drop_part
    echo "shrink: $in: failed" >&2
    return 1
  fi
  if $dry; then
    run touch -r "$in" "$part"
    run mv -f "$part" "$out"
    part=""
    written+="$out"$'\n'
    return 0
  fi
  before="$(stat -f %z "$in")" after="$(stat -f %z "$part")"
  if ((after >= before)); then
    drop_part
    echo "$in $(human "$before"): the result wasn't smaller ($(human "$after")), so nothing was written"
    return 0
  fi
  if ! { touch -r "$in" "$part" && mv -f "$part" "$out"; }; then
    drop_part
    return 1
  fi
  part=""
  written+="$out"$'\n'
  echo "$in $(human "$before") → $(human "$after") (-$(((before - after) * 100 / before))%) → $out"
}

status=0
for file in "${files[@]}"; do
  shrink_file "$file" || status=1
done
exit "$status"
