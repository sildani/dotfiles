# Shared zsh config, linked to ~/.zshrc by install.sh. Machine-specific setup
# (PATH, nvm, its own tools) goes in ~/.zshrc.local, which is sourced last.

# Each PATH entry once, keeping the first copy, whatever adds it below or in
# ~/.zshrc.local, so PATH doesn't grow in nested shells. Both names: -U on path
# alone misses `export PATH=...`.
typeset -U PATH path

# Homebrew: Apple Silicon or Intel prefix, whichever is installed.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
export PATH=$HOME/bin:$HOME/.local/bin:$PATH

# A machine's core.editor still wins for git.
export EDITOR=nvim VISUAL=nvim

# The repo root, wherever it was cloned: this file with symlinks resolved (:A),
# two levels up. Docs and extras lines use it; tmux inherits it.
export DOTFILES="${${(%):-%x}:A:h:h}"

# Oh My Zsh (https://github.com/ohmyzsh/ohmyzsh/wiki/Settings)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
DISABLE_UNTRACKED_FILES_DIRTY="true" # faster git status in big repos
HIST_STAMPS="yyyy-mm-dd"
# update.sh does this, and the reminder below replaces Oh My Zsh's prompt.
zstyle ':omz:update' mode disabled
plugins=(git tmux)

if [[ -f $ZSH/oh-my-zsh.sh ]]; then
  source $ZSH/oh-my-zsh.sh
else
  print -u2 "zshrc: Oh My Zsh not found at $ZSH; re-run install.sh from the dotfiles repo"
  bindkey -e  # Oh My Zsh sets this; with vi in EDITOR, zsh starts on vi keys
fi

# One line when update.sh hasn't run for 14 days, with no network call. Showing
# it restarts the 14 days. install.sh starts the clock; no timestamp stays quiet.
() {
  [[ -o interactive ]] || return 0
  local stamp="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/last-update"
  local -a overdue=($stamp(Nmd+13))
  (( $#overdue )) || return 0
  print -r -- 'dotfiles: 14 days since the last update; run "$DOTFILES/update.sh"'
  touch $stamp
}

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
